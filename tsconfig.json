{
  "compilerOptions": {
    // 浏览器应用交给 Vite 打包输出，TypeScript 只负责静态类型检查。
    "noEmit": true,

    // 保留显式 .ts 相对导入写法，同时让 Vite 和 Vitest 直接解析源码。
    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "target": "esnext",
    "types": ["node"],

    // 启用自动 JSX 转换，并通过仓内自定义条件 nano-solid-source 让 TypeScript 直接解析 src/*.ts 源码。
    "jsx": "react-jsx",
    "jsxImportSource": "nano-solid",
    "customConditions": ["nano-solid-source"],

    // 让 TypeScript 检查可能不存在的值，以及可选属性的赋值。
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // 把每个文件作为模块检查，要求类型导入显式写成 import type。
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",

    // 使用依赖提供的声明，把检查重点放在项目自己的源码。
    "skipLibCheck": true
  },
  // 覆盖当前快照的源码、测试和仓库工具，供编辑器和 pnpm typecheck 检查。
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "scripts/**/*.ts",
    "vite.config.ts"
  ]
}
