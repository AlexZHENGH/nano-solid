{
  "name": "nano-solid",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "nano-solid-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "nano-solid-source": "./src/jsx-runtime.ts",
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "nano-solid-source": "./src/jsx-runtime.ts",
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./compiler-runtime": {
      "nano-solid-source": "./src/compiler-runtime.ts",
      "types": "./dist/compiler-runtime.d.ts",
      "default": "./dist/compiler-runtime.js"
    },
    "./vite": {
      "nano-solid-source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build:lib": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "build:demos": "vite build",
    "build": "pnpm run typecheck && pnpm run build:lib && pnpm run build:demos",
    "prepack": "pnpm run build:lib",
    "verify:pack": "node tools/verify-package.ts",
    "start": "vite preview",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "docs:dev": "pnpm --filter nano-solid-docs dev",
    "docs:build": "pnpm --filter nano-solid-docs build",
    "tags:check": "node scripts/refresh_tags.ts --check",
    "tags:refresh": "node scripts/refresh_tags.ts --refresh",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@babel/generator": "^8.1.3",
    "@babel/parser": "^8.1.3",
    "@babel/traverse": "^8.1.3",
    "@babel/types": "^8.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "5.1.0",
    "wrangler": "^4.168.0"
  },
  "peerDependencies": {
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
