{
  "name": "nano-solid",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#nano-solid": "./src/index.ts",
    "#nano-solid/jsx-runtime": "./src/jsx-runtime.ts",
    "#nano-solid/jsx-dev-runtime": "./src/jsx-runtime.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "start": "vite preview",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "docs:dev": "pnpm --filter nano-solid-docs dev",
    "docs:build": "pnpm --filter nano-solid-docs build",
    "tags:check": "node scripts/refresh_tags.ts --check",
    "tags:refresh": "node scripts/refresh_tags.ts --refresh",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "5.1.0",
    "wrangler": "^4.168.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
