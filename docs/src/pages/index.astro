import { frontmatter as manualSubscription } from "./lessons/2.2-manual-subscription.mdx";
import { frontmatter as trackEffects } from "./lessons/2.3-track-effects.mdx";
import { frontmatter as effectLifecycle } from "./lessons/3.0-effect-lifecycle.mdx";
import { frontmatter as sameValue } from "./lessons/3.1-same-value.mdx";
import { frontmatter as dynamicDependencies } from "./lessons/3.2-dynamic-dependencies.mdx";
import { frontmatter as disposeEffect } from "./lessons/3.3-dispose.mdx";
import { frontmatter as throwCleanup } from "./lessons/3.4-throw-cleanup.mdx";
import { frontmatter as domRenderer } from "./lessons/4.0-dom-renderer.mdx";
import { frontmatter as browserVite } from "./lessons/4.1-browser-vite.mdx";
import { frontmatter as reactiveText } from "./lessons/4.2-reactive-text.mdx";
import { frontmatter as renderableTree } from "./lessons/4.3-renderable-tree.mdx";
import { frontmatter as renderUnmount } from "./lessons/4.4-render-unmount.mdx";
import { frontmatter as jsxComponents } from "./lessons/5.0-jsx-components.mdx";
import { frontmatter as jsxRuntime } from "./lessons/5.1-jsx-runtime.mdx";
import { frontmatter as propsEvents } from "./lessons/5.2-props-and-events.mdx";
import { frontmatter as reactiveProps } from "./lessons/5.3-reactive-props.mdx";
import { frontmatter as components } from "./lessons/5.4-components.mdx";
import { frontmatter as ownershipShow } from "./lessons/6.0-ownership-and-show.mdx";

/** 保留站点的部署前缀，方便首页和目录拼接课程链接。 */
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
/** 首页两处入口共用同一条路径。 */
const setupUrl = `${baseUrl}/lessons/1-setup/`;
const reactivityUrl = `${baseUrl}/lessons/2.0-reactivity/`;
const signalUrl = `${baseUrl}/lessons/2.1-signal/`;
const manualSubscriptionUrl = `${baseUrl}/lessons/2.2-manual-subscription/`;
const trackEffectsUrl = `${baseUrl}/lessons/2.3-track-effects/`;
const effectLifecycleUrl = `${baseUrl}/lessons/3.0-effect-lifecycle/`;
const sameValueUrl = `${baseUrl}/lessons/3.1-same-value/`;
const dynamicDependenciesUrl = `${baseUrl}/lessons/3.2-dynamic-dependencies/`;
const disposeEffectUrl = `${baseUrl}/lessons/3.3-dispose/`;
const throwCleanupUrl = `${baseUrl}/lessons/3.4-throw-cleanup/`;
const domRendererUrl = `${baseUrl}/lessons/4.0-dom-renderer/`;
const browserViteUrl = `${baseUrl}/lessons/4.1-browser-vite/`;
const reactiveTextUrl = `${baseUrl}/lessons/4.2-reactive-text/`;
const renderableTreeUrl = `${baseUrl}/lessons/4.3-renderable-tree/`;
const renderUnmountUrl = `${baseUrl}/lessons/4.4-render-unmount/`;
const jsxComponentsUrl = `${baseUrl}/lessons/5.0-jsx-components/`;
const jsxRuntimeUrl = `${baseUrl}/lessons/5.1-jsx-runtime/`;
const propsEventsUrl = `${baseUrl}/lessons/5.2-props-and-events/`;
const reactivePropsUrl = `${baseUrl}/lessons/5.3-reactive-props/`;
const componentsUrl = `${baseUrl}/lessons/5.4-components/`;
const ownershipShowUrl = `${baseUrl}/lessons/6.0-ownership-and-show/`;
---

<BookLayout
  title="nano-solid: 从零实现一个响应式前端框架"
  description="用 TypeScript 一步步实现细粒度响应式框架。"
>
  <section class="course-intro" aria-label="课程介绍">
    <p>
      这门课从一个计数器开始。你会用 TypeScript 实现状态读写、DOM 更新和 JSX，再用自己写的框架做一个能保存任务的 Todo 应用。
    </p>

    <h2>SolidJS 是什么？</h2>
    <p>
      SolidJS 是一个用 JSX 构建网页界面的框架。它会记录界面各处读取了哪些状态：每当计数变化，只有读到这个计数的表达式会重新计算，页面上的数字也跟着更新。这种机制叫<a
        href="https://v1.solidjs.com/advanced-concepts/fine-grained-reactivity"
        >细粒度响应式</a
      >，也是 nano-solid 的设计起点。
    </p>

    <h2>为什么亲手做一遍？</h2>
    <ul>
      <li>
        <strong>练习架构设计。</strong>随着功能加入，决定哪些职责属于状态、渲染和应用层。比如一个组件卸载时，谁负责结束它的订阅和事件监听？用测试把这个约定固定下来。
      </li>
      <li>
        <strong>理解前端框架。</strong>沿着一次点击追到状态写入、依赖通知和 DOM 更新，再自己实现列表重排，看看已有节点是怎么被复用的。
      </li>
      <li>
        <strong>搭建 TypeScript 项目。</strong>配置类型检查、Vite 开发和 Vitest 测试，生成库代码与类型声明，再到独立项目里安装验证。
      </li>
    </ul>

    <p>
      练习时先运行题目里的例子，动手修改，再用测试和解答核对结果。
      从 <a href={setupUrl}>{setup.title}</a> 开始。
    </p>
  </section>

  <h2 id="lessons">课程目录</h2>
  <!-- 从题目页读取章名，让目录和正文使用同一个标题。 -->
  <h3 class="course-chapter"><a href={setupUrl}>{setup.title}</a></h3>
  <h3 class="course-chapter"><a href={reactivityUrl}>{reactivity.title}</a></h3>
  <ul class="course-lessons">
    <li><a href={signalUrl}>{signal.title}</a></li>
    <li><a href={manualSubscriptionUrl}>{manualSubscription.title}</a></li>
    <li><a href={trackEffectsUrl}>{trackEffects.title}</a></li>
  </ul>
  <h3 class="course-chapter"><a href={effectLifecycleUrl}>{effectLifecycle.title}</a></h3>
  <ul class="course-lessons">
    <li><a href={sameValueUrl}>{sameValue.title}</a></li>
    <li><a href={dynamicDependenciesUrl}>{dynamicDependencies.title}</a></li>
    <li><a href={disposeEffectUrl}>{disposeEffect.title}</a></li>
    <li><a href={throwCleanupUrl}>{throwCleanup.title}</a></li>
  </ul>
  <h3 class="course-chapter"><a href={domRendererUrl}>{domRenderer.title}</a></h3>
  <ul class="course-lessons">
    <li><a href={browserViteUrl}>{browserVite.title}</a></li>
    <li><a href={reactiveTextUrl}>{reactiveText.title}</a></li>
    <li><a href={renderableTreeUrl}>{renderableTree.title}</a></li>
    <li><a href={renderUnmountUrl}>{renderUnmount.title}</a></li>
  </ul>
  <h3 class="course-chapter"><a href={jsxComponentsUrl}>{jsxComponents.title}</a></h3>
  <ul class="course-lessons">
    <li><a href={jsxRuntimeUrl}>{jsxRuntime.title}</a></li>
    <li><a href={propsEventsUrl}>{propsEvents.title}</a></li>
    <li><a href={reactivePropsUrl}>{reactiveProps.title}</a></li>
    <li><a href={componentsUrl}>{components.title}</a></li>
  </ul>
  <h3 class="course-chapter"><a href={ownershipShowUrl}>{ownershipShow.title}</a></h3>
</BookLayout>
